		"autoprefixer": "^10.5.0",
		"eslint": "^8.57.1",
		"eslint-config-next": "14.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"postcss": "^8.5.14",
		"tailwindcss": "^3.4.19",
